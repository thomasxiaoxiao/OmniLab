# Development binds to localhost:8000; PM2 uses localhost:8010.
# Set APP_HOST=0.0.0.0 only when intentionally exposing the service.
APP_HOST=127.0.0.1
# APP_PORT=8010
# Allowed HTTP hosts for a reverse proxy; local access is the default.
# APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],your-authorized-host.example
# Add application credentials here when integrations are implemented.
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=

# Optional Omnigent integration. Default local AnyJev decisions require no credentials.
# OMNIGENT_SERVER_URL=http://127.0.0.1:6767
# OMNIGENT_AGENT_NAME=research-worker
# OMNIGENT_HOST_ID=<online-host-id-from-research-runtime-status>
# OMNIGENT_CODEX_PATH=/absolute/path/to/current/codex
# RESEARCH_AGENT_WORKSPACE=/absolute/path/to/repo/.runtime/research-agent
# OMNIGENT_API_TOKEN=
# For future paid API usage: configure-agent --auth api-key --model <model-id>
# OPENAI_API_KEY=
# RESEARCH_MODEL=<model-id-configured-in-omnigent>
# DATABRICKS_CONFIG_PROFILE=<your-profile>
# Store Omnigent state in the repo rather than the user home, if desired.
# OMNIGENT_DATA_DIR=/absolute/path/to/repo/.runtime/omnigent
# Stable absolute paths keep data visible across PM2 release directories.
# RESEARCH_OUTPUT_DIR=/absolute/path/to/repo/output/research
# RESEARCH_SOURCES_DIR=/absolute/path/to/repo/data/sources
# RESEARCH_PAPER_PATH=/absolute/path/to/repo/data/papers/2607.24975v1.pdf

# Pinned local AnyJev model; use a stable absolute path for PM2 releases.
# RESEARCH_DECISION_MODEL_DIR=/absolute/path/to/repo/data/models/qwen3-4b-decision
